// Build configuration for the iOS app. Adjust the values here, or – to keep personal settings out of
// Git – copy Local.xcconfig.example to Local.xcconfig, which overrides anything in this file.
//
// Note: "//" starts a comment in .xcconfig files, so URLs are written as "https:/$()/host".

#include "Version.xcconfig"

// Backend the app talks to (API, uploads and cached images live below this origin).
WISHLIST_SERVER_URL = https:/$()/wishlist.hein.cx

// Origin used for share links that are sent to friends and family. Usually the same as the server.
WISHLIST_WEB_URL = $(WISHLIST_SERVER_URL)

// Host for Universal Links, Handoff and shared passwords (Associated Domains in Wishlist.entitlements).
// Its server must list this app in /.well-known/apple-app-site-association (IOS_APP_IDS in the server's .env).
WISHLIST_WEB_HOST = wishlist.hein.cx

WISHLIST_DISPLAY_NAME = Wishlist
WISHLIST_BUNDLE_ID = cx.hein.wishlist
WISHLIST_URL_SCHEME = whateverwishlist

// Set your Apple Developer Team ID to run on a device (Local.xcconfig is the better place for it).
DEVELOPMENT_TEAM =

// Associated Domains (Universal Links, Handoff, shared passwords) need a paid developer account.
// Without one, clear this in Local.xcconfig: WISHLIST_ENTITLEMENTS =
WISHLIST_ENTITLEMENTS = Wishlist/Wishlist.entitlements

#include? "Local.xcconfig"
