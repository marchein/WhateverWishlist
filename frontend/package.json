{
  "name": "frontend",
  "version": "1.0.3",
  "author": "Marc Hein",
  "homepage": "https://hein.cx/",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "icons:generate": "node scripts/generate-icons.mjs",
    "test:icons": "node --test scripts/icons.test.mjs",
    "ios:sync": "ng build && cap sync ios",
    "ios": "ng build && cap sync ios && cap open ios"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/router": "22.2.4",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "8.0.4",
    "@ionic/angular": "^9.0.10",
    "ionicons": "^8.1.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.4",
    "@angular/language-service": "22.2.4",
    "@capacitor/cli": "8.6.0",
    "@ionic/angular-toolkit": "^13.0.0",
    "angular-eslint": "22.6.0",
    "eslint": "^10.14.0",
    "jsdom": "^30.1.3",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "~5.0.5"
  },
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.4"
  },
  "description": "Frontend for the wishlist application"
}
